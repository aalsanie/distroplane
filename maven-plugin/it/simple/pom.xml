<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>test.integration</groupId><artifactId>release-handoff</artifactId><version>1.0.0</version><packaging>pom</packaging>
  <build><plugins><plugin>
    <groupId>io.github.aalsanie</groupId><artifactId>distroplane-maven-plugin</artifactId><version>1.0.1-SNAPSHOT</version>
    <configuration><config>distroplane.json</config><timeoutSeconds>${distroplane.timeoutSeconds}</timeoutSeconds></configuration>
  </plugin></plugins></build>
  <properties><distroplane.timeoutSeconds>60</distroplane.timeoutSeconds></properties>
  <profiles><profile><id>doctor-credential</id><build><plugins><plugin>
    <groupId>io.github.aalsanie</groupId><artifactId>distroplane-maven-plugin</artifactId>
    <configuration><credentialMappings><publish-auth>DISTROPLANE_DOCTOR_UNSET_FIXTURE_ENV</publish-auth></credentialMappings></configuration>
  </plugin></plugins></build></profile></profiles>
</project>
